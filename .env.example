# Local API uses HOST/PORT from the process environment. No .env file is required.
# Provider settings below are reserved for later AI implementation.
OPENAI_API_KEY=
# Model names will be selected and verified during API implementation.
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_SPEECH_MODEL=
HOST=127.0.0.1
PORT=3001
