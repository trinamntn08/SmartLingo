# syntax=docker/dockerfile:1
FROM node:24.19.0-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
# tsx is a locked development tool used by the existing TypeScript API start.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/learner/package.json apps/learner/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/content/package.json packages/content/package.json
RUN --mount=type=secret,id=npm_ca \
    if [ -f /run/secrets/npm_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/npm_ca; fi; \
    npm ci --include=dev --ignore-scripts --no-audit --no-fund
COPY apps/api/src/ ./apps/api/src/
COPY packages/domain/src/ ./packages/domain/src/
COPY packages/content/src/ ./packages/content/src/
COPY tsconfig.json ./
RUN chmod -R a+rX /app/apps /app/packages \
    && chmod a+r /app/package.json /app/package-lock.json /app/tsconfig.json \
    && mkdir -p /app/data && chown node:node /app/data
USER node
EXPOSE 3001
CMD ["node", "--import", "tsx", "apps/api/src/server.ts"]
