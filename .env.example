# Local API uses HOST/PORT from the process environment. No .env file is required.
# Optional French text practice: both settings required; credentials stay server-side.
# Configure these in the API process environment; no .env file is loaded automatically.
OPENAI_API_KEY=
# Choose a Responses API model supporting Structured Outputs; no default paid model.
OPENAI_TEXT_MODEL=
# Daily reserved attempts, UTC day, 1-200. In-memory allowance resets on API restart.
SMARTLINGO_AI_DAILY_LIMIT=40
# Optional recorded-input transcription model; no default or automatic paid calls.
OPENAI_TRANSCRIPTION_MODEL=
# Reserved: no OpenAI speech provider is implemented; Azure configuration is below.
OPENAI_SPEECH_MODEL=
# Optional saved French neural speech. Azure credentials stay server-side.
# Profile generation is explicit; normal playback never creates paid audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SMARTLINGO_SPEECH_DAILY_LIMIT=40
# Separate synthetic speech/text cache; excluded from learner/curriculum backups.
# SMARTLINGO_SPEECH_DATABASE_PATH=data/generated-speech.sqlite
HOST=127.0.0.1
PORT=3001
# Optional: select an existing recovered curriculum file, relative to repository root.
# SMARTLINGO_DATABASE_PATH=data/recovered.sqlite
