{
  "name": "smartlingo",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first French learning preview",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "files": [
    "AGENTS.md",
    "CONTRIBUTING.md",
    "PROJECT_PLAN.md",
    "docs/",
    "scripts/",
    "tooling/",
    ".githooks/",
    ".env.example"
  ],
  "scripts": {
    "setup": "node scripts/setup-git.mjs",
    "setup:codex": "node scripts/install-codex.mjs --apply",
    "setup:codex:plan": "node scripts/install-codex.mjs",
    "setup:finish": "node scripts/finish-setup.mjs --apply",
    "setup:finish:plan": "node scripts/finish-setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "node scripts/check-repo.mjs && npm run typecheck",
    "check:staged": "node scripts/check-repo.mjs --staged",
    "test": "npm run test:tooling && npm run test:app",
    "dev": "npm run web --workspace @smartlingo/learner",
    "dev:api": "npm run dev --workspace @smartlingo/api",
    "backup:curriculum": "tsx apps/api/src/curriculum-backup-cli.ts backup",
    "restore:curriculum": "tsx apps/api/src/curriculum-backup-cli.ts restore",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run export --workspace @smartlingo/learner && node scripts/prepare-offline-web.mjs",
    "android:doctor": "node scripts/android-apk.mjs doctor",
    "build:apk": "node scripts/android-apk.mjs build",
    "android:install": "node scripts/android-apk.mjs install",
    "android:open": "node scripts/android-apk.mjs open",
    "test:android-contract": "npm run build:web && playwright test --config playwright.android.config.ts",
    "preview:web": "node scripts/serve-web.mjs",
    "test:offline": "npm run build:web && playwright test --config playwright.offline.config.ts",
    "test:app": "tsx --test packages/domain/tests/*.test.ts apps/learner/tests/*.test.ts apps/api/tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:tooling": "node --test scripts/tests/*.test.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "fake-indexeddb": "6.2.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
