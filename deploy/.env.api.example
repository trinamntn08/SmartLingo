# Copy to deploy/.env on the API server. Never upload this filled file.
# Bare API hostname; no scheme/path. HTTPS is managed by Caddy.
SMARTLINGO_API_DOMAIN=
# Exact learner HTTPS origin(s), comma separated. No trailing slash/wildcards.
SMARTLINGO_ALLOWED_ORIGINS=
# Generate two DIFFERENT random tokens (at least 32 chars), not provider keys.
SMARTLINGO_ADMIN_TOKEN=
SMARTLINGO_BETA_TOKEN=
# Optional paid features stay unavailable until both key and model are set.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
SMARTLINGO_AI_DAILY_LIMIT=40
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
SMARTLINGO_SPEECH_DAILY_LIMIT=40
